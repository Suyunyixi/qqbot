# 文件修改后，新回合及启动自检自动读取。
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=

# Anthropic 兼容接口示例：
# MODEL_PROVIDER=anthropic
# MODEL_BASE_URL=https://api.deepseek.com/anthropic

# 宿主机数据库目录及容器内数据库路径，切换目录前先迁移旧数据。
BOT_DATA_HOST=./data
BOT_SQLITE_PATH=/data/bot.sqlite
BOT_CHECKPOINT_PATH=/data/checkpoints.sqlite
# 以下均可填写项目相对路径或宿主机绝对路径。
BOT_WORKSPACE_HOST=./workspace
BOT_CONFIG_HOST=./config
BOT_PLUGINS_HOST=./plugins
BOT_MODEL_ENV_HOST=./.env
SEARXNG_CONFIG_HOST=./docker/searxng-settings.yml
# 管理页默认仅对本机开放；修改端口后需重新创建容器。
BOT_WEB_BIND=127.0.0.1
BOT_WEB_PORT=8765
# NPM_REGISTRY=https://registry.npmjs.org/
# PYPI_INDEX_URL=https://pypi.org/simple/
